SW-05
configure snmp sysName "EXOS-SW-05"
configure sys-recovery-level switch reset

#
# Module vlan configuration.
#
configure vlan default delete ports all
configure vr VR-Default delete ports 1-5
create qosprofile "QP2"
create qosprofile "QP3"
create qosprofile "QP4"
create qosprofile "QP5"
create qosprofile "QP6"
create qosprofile "QP7"
create vlan "LOOPBACK"
enable loopback-mode vlan LOOPBACK
create vlan "NET-1"
enable loopback-mode vlan NET-1
create vlan "NET-2"
enable loopback-mode vlan NET-2
create vlan "NET-3"
enable loopback-mode vlan NET-3
create vlan "vlan-45"
configure vlan vlan-45 tag 45
create vlan "vlan-52"
configure vlan vlan-52 tag 52
configure vlan Default add ports 2-5 untagged
configure vlan vlan-45 add ports 1 tagged
configure vlan vlan-52 add ports 2 tagged
configure vlan LOOPBACK ipaddress 5.5.5.5 255.255.255.255
enable ipforwarding vlan LOOPBACK
configure vlan NET-1 ipaddress 5.5.1.1 255.255.255.0
configure vlan NET-2 ipaddress 5.5.2.1 255.255.255.0
configure vlan NET-3 ipaddress 5.5.3.1 255.255.255.0
configure vlan vlan-45 ipaddress 45.45.45.2 255.255.255.252
enable ipforwarding vlan vlan-45
configure vlan vlan-52 ipaddress 52.52.52.1 255.255.255.252
enable ipforwarding vlan vlan-52
configure qosscheduler strict-priority ports 1
configure qosscheduler strict-priority ports 2
configure qosscheduler strict-priority ports 3
configure qosscheduler strict-priority ports 4
configure qosscheduler strict-priority ports 5

# Module ospf configuration.
#
configure ospf routerid 5.5.5.5
enable ospf
create ospf area 0.0.0.2
create ospf area 0.0.0.6
configure ospf add virtual-link 4.4.4.4 0.0.0.2
configure ospf add vlan LOOPBACK area 0.0.0.2 passive
configure ospf add vlan vlan-45 area 0.0.0.2 link-type point-to-point
configure ospf add vlan vlan-52 area 0.0.0.6 link-type point-to-point

